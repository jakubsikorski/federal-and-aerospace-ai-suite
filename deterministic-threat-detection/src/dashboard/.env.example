# Written to .env by 'make env' (LOCAL_UID/LOCAL_GID and DASHBOARD_BIND are detected).
MQTT_PORT=1884
DASHBOARD_PORT=8080
# Lab-network address the dashboard listens on (machine-1 eno0).
DASHBOARD_BIND=
LOCAL_UID=1000
LOCAL_GID=1000
# iperf = real load from machine-4; sim = only record the slider value
TRAFFIC_MODE=iperf
TRAFFIC_MAX_MBPS=1000
# moxa = read the switch through machine-2; sim = fake switch
SWITCH_MODE=moxa
# 1 lets the dashboard toggle apply the shaper schedule on switch port 1 (port 2 is always refused). Default 0 = read-only.
SWITCH_ALLOW_WRITE=0

# System load card: name=url of each machine's metrics-manager event stream, comma separated.
# This machine's own one is published on loopback (METRICS_PORT); the camera machines publish theirs on 19090.
# METRICS_SOURCES=machine-1=http://127.0.0.1:19090/metrics/stream,machine-2=http://<machine-2 address>:19090/metrics/stream
METRICS_SOURCES=
METRICS_PORT=19090
