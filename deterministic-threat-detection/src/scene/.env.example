# Self-contained environment for the deterministic threat detection (HOTA) app.
# Run ./up.sh; it generates secrets and fills SUPASS/HOST_IP below.

HOST_IP=

# This machine's address on the lab network, as the browser reaches it (WebRTC ICE candidates); set by make up
LAB_IP=

# SceneScape images (manager, controller, analytics)
SCENESCAPE_VERSION=2026.3.0-20261103-weekly

# DL Streamer Pipeline Server image
DLSTREAMER_PIPELINE_SERVER_IMAGE=intel/dlstreamer-pipeline-server:2026.3.0-ubuntu24-rc1

# Camera source for the scene stack: always taken from the command line (`make up SOURCE=basler`), default video;
#   video   the synchronised test videos from the camera machines, scored live with HOTA (default)
#   basler  Basler GigE cameras: the serial numbers below; builds the pipeline server image with the pylon SDK
#   (written here by `make up` only so the containers see it; never read back as a default)
SOURCE=video
CAMERA1_ID=Cam_x1_0
CAMERA2_ID=Cam_x2_0
BASLER_CAMERA1_SERIAL=23117381
BASLER_CAMERA2_SERIAL=23117382
BASLER_FPS=15
# macvlan address of the pipeline server on the cameras' subnet (must be free) and the VLAN interface it attaches to
BASLER_CONTAINER_IP=192.168.3.61
BASLER_PARENT_IFACE=tsn0.3
# Frame size sent to the tracker (blank = 800x600 for video, 1920x1080 otherwise); must match the scene's camera calibration
FRAME_WIDTH=
FRAME_HEIGHT=

# RTSP camera hosts on the TSN VLAN (must match src/mediamtx/mediamtx.yml)
CAMERA1_HOST=192.168.127.12
CAMERA2_HOST=192.168.127.13

# Comma-separated hosts/IPs allowed in the browser URL; set by make up; '*' allows any host
ALLOWED_HOSTS=*

NGINX_CLIENT_MAX_BODY_SIZE=132m

# Admin password; populated by up.sh from src/secrets/supass
SUPASS=

# Broker runs as the image default user; leave blank (see up.sh)
UID=
GID=
