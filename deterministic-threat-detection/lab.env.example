# Lab configuration. Copy this file to lab.env and fill it in:
#
#     cp lab.env.example lab.env
#
# lab.env is the ONLY place that holds addresses; it is kept out of git. Everything else (Makefiles, scripts,
# compose files, the dashboard backend) reads it.
#
# Each machine has two kinds of address:
#   LAB   the normal network: ssh, the dashboard in the browser, the metrics streams. Not part of the TSN data path.
#   TSN   the VLAN interfaces on the TSN switch: camera data (VLAN 1) and the background load (VLAN 5).
#
# Machine roles:  M1 = this machine (dashboard, SceneScape)   M2 = camera 1 (Cam_x1_0)
#                 M3 = camera 2 (Cam_x2_0)                    M4 = traffic injector

SSH_USER=

M1_LAB_IP=
M2_LAB_IP=
M3_LAB_IP=
M4_LAB_IP=

# camera data VLAN (the VLAN the cameras' RTSP streams and the MQTT results travel on)
M1_TSN_IP=
M2_TSN_IP=
M3_TSN_IP=

# background-load VLAN: iperf3 server on M1, the client on M4 binds this address
M1_NOISE_IP=
M4_NOISE_IP=

# management address of the Moxa TSN switch (reached from M2, never from this machine's TSN port)
SWITCH_IP=
