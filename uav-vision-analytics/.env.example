# This file is used to set environment variables for the uav-vision-analytics application.

# HOST_IP — auto-detected by 'make init' (LAN IP so QGroundControl/VLC/ffplay on
# other devices can reach the RTSP stream). It also binds nginx's published
# ports (80, 443, 8555): "${HOST_IP:-127.0.0.1}:PORT:PORT" in the compose files.
# Set HOST_IP=127.0.0.1 for loopback-only access (breaks remote QGroundControl/ffplay
# viewing) if the host is not on a trusted, isolated network.
HOST_IP=

# DL Streamer Pipeline Server
DLSTREAMER_PIPELINE_SERVER_IMAGE=intel/dlstreamer-pipeline-server:2026.3.0-ubuntu24-rc1

# GPU Device Paths
# Leave empty to use defaults; otherwise set to your GPU device paths.
# Examples: /dev/dri/card1, /dev/dri/renderD129, etc.
GPU_DEVICE=
GPU_RENDER_DEVICE=

# NPU Device Path
# Leave empty to use /dev/null (NPU pipelines disabled) or set to your NPU device.
# Example: /dev/accel/accel0
NPU_DEVICE=

# Group IDs owning the GPU/NPU/camera devices. Written automatically by 'make pymav-up' / 'make uavsdk-up'
# (scripts/update_device_gids.sh); no need to set them.
GPU_CARD_GID=
GPU_RENDER_GID=
NPU_GID=
CAMERA_GID=

# Live cameras (Intel RealSense, USB webcams, other UVC cameras) made available to the pipeline server.
# Up to four; use the same path as 'device:' in configs/cameras-pymavlink.yaml. Prefer the stable names in
# /dev/v4l/by-id/ over /dev/videoN (the numbers change with plug order). 'make init' fills CAMERA_DEVICE_1
# with the first USB video node that supports MJPG or YUYV. Empty = unused. A RealSense has several
# nodes (depth, IR, colour): pick the colour one (see v4l2-ctl --list-devices).
CAMERA_DEVICE_1=
CAMERA_DEVICE_2=
CAMERA_DEVICE_3=
CAMERA_DEVICE_4=
