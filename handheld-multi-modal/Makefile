# Handheld operator application. Run `make` for the command list and
# docs/application/application-operations.md for details.
SHELL := /bin/bash
.SHELLFLAGS := -Eeuo pipefail -c
.ONESHELL:
.DEFAULT_GOAL := help

CAMERAS ?= 2
ASSET_ROOT ?= $(CURDIR)
export ASSET_ROOT := $(abspath $(ASSET_ROOT))
export WAIT_SECONDS ?= 360
MODEL_WAIT_SECONDS ?= 3600
AI_WAIT_SECONDS ?= 3600
export RENDER_GID ?= $(shell stat -c '%g' /dev/dri/renderD128 2>/dev/null)
export ACCEL_GID ?= $(shell stat -c '%g' /dev/accel/accel0 2>/dev/null)
export ASSET_GID := $(shell id -g)
export CAMERAS
# SpeechT5 device. `setup` records it in config/devices.yaml, so it stays until the next up.
# `setup` also records the deployment cameras: cam1..camCAMERAS for demo-up,
# none for up (cameras are then added in the console).
TTS_DEVICE ?= CPU
override TTS_DEVICE := $(shell echo '$(TTS_DEVICE)' | tr a-z A-Z)
export TTS_DEVICE
TLS_DIR := $(ASSET_ROOT)/config/tls
ASSET_COMPOSE := docker compose -f compose/handheld-multi-modal.yaml
# devices.yaml is generated by `setup`; stop/down/status must work without it.
COMPOSE := $(ASSET_COMPOSE) -f compose/cameras.yaml -f compose/phase4-demo.override.yaml \
  $$([[ -f "$(ASSET_ROOT)/config/devices.yaml" ]] && echo -f "$(ASSET_ROOT)/config/devices.yaml")
comma := ,
empty :=
space := $(empty) $(empty)
CAMERA_IDS := $(foreach i,$(shell seq 1 $(CAMERAS) 2>/dev/null),cam$(i))
ANNOTATED_IDS := $(patsubst cam%,annotated%,$(CAMERA_IDS))

.PHONY: help prereq demo-prereq up demo-up demo-mission status stop \
  pipelines-restart down clean clean-demo clean-history clean-all \
  demo-stop demo-down demo-status demo-pipelines-restart \
  bundle bundle-load preflight setup tls asset-permissions model-downloader-up \
  check test test-ui test-assets test-phase5

help:
	@echo 'Handheld operator application'
	@echo
	@echo 'Deploy with your own cameras'
	@echo '  make prereq           Check the host; download the YOLO26s INT8 detector'
	@echo '  make up               Start the application (runs prereq first)'
	@echo '                        Then publish H.264 RTSP on this device to'
	@echo '                        rtsp://127.0.0.1:8554/cam1 ... camN'
	@echo
	@echo 'Deploy with the demo camera feeds'
	@echo '  make demo-prereq      prereq + download and prepare the demo videos'
	@echo '  make demo-up          Start the application with looping demo cameras'
	@echo '  make demo-mission     Optional: load examples/demo-mission-packet.pdf'
	@echo
	@echo 'Operate'
	@echo '  make status           Services and camera feed health'
	@echo '  make stop             Stop every service; nothing is deleted'
	@echo '  make up / demo-up     Also restarts a running application (make stop first for a full restart)'
	@echo '  make pipelines-restart  Restart Backend and DLSPS; language models stay loaded'
	@echo '  make speech-device TTS_DEVICE=GPU  Move speech (SpeechT5) to GPU; CPU moves it back'
	@echo '  make down             Remove containers; keep models, history and TLS'
	@echo '  demo-stop, demo-down and demo-status are the same as stop, down and status.'
	@echo
	@echo 'Copy to another device (no internet needed there)'
	@echo '  make bundle BUNDLE=<dir>       Save images, source, models and caches (after a demo-up)'
	@echo '                                 IMAGES=no skips docker save when images are copied separately'
	@echo '  make bundle-load BUNDLE=<dir>  Verify and restore them, then run make demo-up'
	@echo
	@echo 'Clean up'
	@echo '  make clean            down + remove generated per-device config'
	@echo '  make clean-demo       Remove demo videos and demo camera containers'
	@echo '  make clean-history CONFIRM=yes  Delete tracks, evidence images, rules, alerts, mission documents'
	@echo '  make clean-all CONFIRM=yes      All of the above + downloaded models, caches and TLS keys'
	@echo
	@echo 'Checks: make check          Images, models and demo videos complete; once started, every service answers'
	@echo '        make test | test-ui | test-assets | test-phase5 (needs demo-up)'
	@echo
	@echo 'Options: CAMERAS=1..2 demo cameras (default 2)  TTS_DEVICE=CPU|GPU (default CPU)'
	@echo '         HOST_IP=<LAN address>  ASSET_ROOT=<path>'
	@echo 'The first start downloads several GB of models (internet, up to an hour); later starts run offline.'

# Shown while waiting for services that download on their first start.
SETUP_NOTE := The stock Model Download installs its Python packages from PyPI on every start (about 2-5 min with internet).
MODEL_NOTE := The first start downloads several GB of models; later starts use the cache.

# Only this small polling helper is shared between startup checks.
define readiness
# Optional per call: WAIT_CONTAINER=<name> shows its latest log line, fails at
# once if it stops, and prints its logs on failure; WAIT_HINT=<text> says what
# to check when it does not become ready.
wait_for() {
  local description=$$1
  shift
  local container=$${WAIT_CONTAINER:-} hint=$${WAIT_HINT:-}
  local start=$$SECONDS deadline=$$((SECONDS + WAIT_SECONDS)) next=$$((SECONDS + 30)) error="" status
  while ((SECONDS < deadline)); do
    if error=$$("$$@" 2>&1 >/dev/null); then
      printf 'ready: %s\n' "$$description"
      return 0
    fi
    if [[ -n $$container ]]; then
      status=$$(docker inspect -f '{{.State.Status}}' "$$container" 2>/dev/null || echo missing)
      if [[ ! $$status =~ ^(created|running|restarting)$$ ]]; then
        printf '\n%s stopped before it was ready (container %s: %s).\n' "$$description" "$$container" "$$status" >&2
        wait_failure_details
        return 1
      fi
    fi
    # Never wait silently: say what is happening every 30 s.
    if ((SECONDS >= next)); then
      printf 'still starting %s (%s elapsed, up to %s): %s\n' "$$description" \
        "$$(duration $$((SECONDS - start)))" "$$(duration "$$WAIT_SECONDS")" "$$(wait_reason "$$error")" >&2
      if [[ -n $$container ]]; then
        printf '  latest from %s: %s\n' "$$container" "$$(last_log_line "$$container")" >&2
      fi
      if [[ -n $$hint && $$next == $$((start + 30)) ]]; then printf '  note: %s\n' "$$hint" >&2; fi
      next=$$((SECONDS + 30))
    fi
    sleep 2
  done
  printf '\n%s was not ready after %s: %s\n' "$$description" "$$(duration "$$WAIT_SECONDS")" "$$(wait_reason "$$error")" >&2
  wait_failure_details
  return 1
}

wait_failure_details() {
  if [[ -n $$container ]]; then
    printf 'Last log lines of %s:\n' "$$container" >&2
    docker logs --tail 15 "$$container" 2>&1 | sed 's/\x1b\[[0-9;]*m//g; s/^/  /' >&2 || true
    printf 'Full log: docker logs %s\n' "$$container" >&2
  fi
  if [[ -n $$hint ]]; then printf 'Hint: %s\n' "$$hint" >&2; fi
}

# Turn curl exit codes into plain words; other probes report their own text.
wait_reason() {
  case $$1 in
    *'curl: (7)'*) echo 'not listening yet' ;;
    *'curl: (52)'*|*'curl: (56)'*) echo 'container is up, service still loading' ;;
    *'curl: (28)'*) echo 'service did not answer within 5 s' ;;
    *'curl: (22)'*) echo 'service answered but is not ready yet' ;;
    '') echo 'not ready yet' ;;
    *) echo "$${1##*$$'\n'}" ;;
  esac
}

last_log_line() {
  docker logs --tail 30 "$$1" 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | grep -v '^[[:space:]]*$$' | tail -n 1 | cut -c1-150 || true
}

duration() {
  if (($$1 >= 60)); then printf '%dm %02ds' $$(($$1 / 60)) $$(($$1 % 60)); else printf '%ds' "$$1"; fi
}

paths_ready() {
  local paths=$$1
  curl -fsS --max-time 3 http://127.0.0.1:9997/v3/paths/list |
    python3 -c '
import json, sys
wanted = set(sys.argv[1].split(","))
items = json.load(sys.stdin).get("items", [])
ready = {item.get("name") for item in items if item.get("ready")}
raise SystemExit(0 if wanted <= ready else 1)
' "$$paths"
}

feeds_ready() {
  local streams=$$1
  curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams |
    python3 -c '
import json, sys
wanted = set(sys.argv[1].split(","))
streams = json.load(sys.stdin)["data"]
healthy = {item["stream_id"] for item in streams if item.get("feed", {}).get("ok") is True}
raise SystemExit(0 if wanted <= healthy else 1)
' "$$streams"
}

telemetry_ready() {
  curl -skfsS --max-time 5 https://127.0.0.1:8443/api/metrics |
    python3 -c '
import json, sys
data = json.load(sys.stdin)["data"]
raise SystemExit(0 if data.get("metrics") else 1)
'
}

json_ready() {
  curl -fsS --max-time 5 "$$1" |
    python3 -c 'import json,sys; sys.exit(json.load(sys.stdin).get(sys.argv[1]) != sys.argv[2])' "$$2" "$$3"
}

endef

# Deletes assets that containers may own (crops belong to DLSPS UID 1999).
define as_root
$(ASSET_COMPOSE) run --rm --no-deps --user 0:0 --entrypoint /bin/sh \
  -v "$$ASSET_ROOT:/assets" model-downloader -ec
endef

define confirm
[[ "$(CONFIRM)" == yes ]] || { printf 'This deletes %s.\nRe-run with CONFIRM=yes to continue.\n' "$1" >&2; exit 1; }
endef

# ---------------------------------------------------------------- prerequisites

preflight:
	@fail() { echo "preflight: $$*" >&2; exit 1; }
	command -v docker >/dev/null || fail "docker is required"
	command -v curl >/dev/null || fail "curl is required"
	command -v python3 >/dev/null || fail "python3 is required"
	command -v openssl >/dev/null || fail "openssl is required"
	[[ $$CAMERAS =~ ^[1-2]$$ ]] || fail "CAMERAS must be 1 or 2; add more cameras in the console"
	[[ $$TTS_DEVICE =~ ^(CPU|GPU)$$ ]] || fail "TTS_DEVICE must be CPU or GPU"
	[[ -e /dev/dri/renderD128 ]] || fail "/dev/dri/renderD128 (Intel GPU driver) is required"
	[[ -e /dev/accel/accel0 ]] || fail "/dev/accel/accel0 (Intel NPU driver) is required"
	# Startup checks call services on 127.0.0.1 with curl. If the proxy settings
	# send those calls to the proxy, nothing local is ever reached.
	if [[ -n "$${http_proxy:-}$${HTTP_PROXY:-}$${https_proxy:-}$${HTTPS_PROXY:-}" ]]; then
	  code=0; curl -s -o /dev/null --max-time 5 http://127.0.0.1:9/ || code=$$?
	  [[ $$code == 7 ]] || fail "requests to 127.0.0.1 go through the proxy; add localhost,127.0.0.1 to no_proxy and NO_PROXY"
	fi

# Containers can leave host bind mounts root-owned after an interrupted run.
# Repair only assets Make owns, plus the data/ and data/dlsps/ parents that a
# fresh run creates as root. Never touch DLSPS crop stores, which belong to
# UID 1999 and can be mode 2700 while a producer is active.
asset-permissions:
	@$(ASSET_COMPOSE) run --rm --no-deps --user 0:0 --entrypoint /bin/sh \
	  -e HOST_UID="$$(id -u)" -e HOST_GID="$$(id -g)" \
	  -v "$$ASSET_ROOT:/assets" model-downloader -ec \
	  'mkdir -p /assets/data/backend \
	            /assets/data/model-download \
	            /assets/data/dlsps/yolo_export \
	            /assets/data/dlsps/demo-video \
	            /assets/config/tls; \
	   chown "$$HOST_UID:$$HOST_GID" /assets/data /assets/data/dlsps; \
	   chown -R "$$HOST_UID:$$HOST_GID" \
	     /assets/data/backend \
	     /assets/data/model-download \
	     /assets/data/dlsps/yolo_export \
	     /assets/data/dlsps/demo-video \
	     /assets/config/tls'

# Stock Model Download (--plugins ultralytics) on loopback port 8200.
model-downloader-up:
	@make --no-print-directory asset-permissions
	@$(readiness)
	install -d -m 2775 "$$ASSET_ROOT/data/model-download"
	$(ASSET_COMPOSE) up -d --no-deps model-downloader
	WAIT_SECONDS=$(MODEL_WAIT_SECONDS) WAIT_CONTAINER=handheld-multi-modal-model-downloader-1 WAIT_HINT="$(SETUP_NOTE)" wait_for "Model Download (ultralytics, port 8200)" curl -fsS --max-time 5 http://127.0.0.1:8200/api/v1/health

# These prerequisites are deliberately sequential, including under make -j.
.NOTPARALLEL:

# Chat Q&A, Whisper and SpeechT5 download their own models on first start.
prereq: preflight asset-permissions
	@if python3 scripts/demo_assets.py check-model; then
	  echo 'YOLO26s INT8 cache verified'
	else
	  code=$$?
	  [[ $$code == 2 ]] || exit "$$code"
	  make --no-print-directory model-downloader-up
	  python3 scripts/demo_assets.py model --timeout $(MODEL_WAIT_SECONDS)
	fi

# Demo camera clips and their frame-rate caps (<video>:<max fps>).
DEMO_CLIPS := person-bicycle-car-detection.mp4:30 pexels-34622113.mp4:25

demo-prereq: prereq
	@python3 scripts/demo_assets.py video
	video="$$ASSET_ROOT/data/dlsps/demo-video"
	# The mp4 clips become MPEG-TS for the camera publishers. classroom.avi is not
	# published; it backs the stock DLSPS sample path used by the smoke tests.
	# The clips have 4-10 s keyframe gaps, so each -stream_loop wrap left the hardware decoder without references and smeared
	# macroblocks into crops until the next keyframe. They are re-encoded once
	# here: keyframe every second, no B-frames, same resolution, at most 30 fps.
	# Detection runs on every frame (zero-term tracking); a 60 fps source outran
	# the detector and its pipeline ended every ~90 s. cam2 is capped at 25 fps
	# (owner-directed) to leave detector headroom. The .maxN name keeps a cache
	# made with another cap from being reused.
	for clip in $(DEMO_CLIPS); do
	  source=$${clip%:*} fps=$${clip##*:}
	  stem="$${source%.*}.max$$fps"
	  codec=(-c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -bf 0 -sc_threshold 0 \
	         -fpsmax "$$fps" -force_key_frames 'expr:gte(t,n_forced*1)')
	  [[ -f "$$video/$$stem.ts" ]] && continue
	  docker run --rm --user "$$(id -u):$$(id -g)" -v "$$video:/video" jrottenberg/ffmpeg:6.1-ubuntu2404 \
	    -hide_banner -loglevel warning -y -fflags +genpts -i "/video/$$source" \
	    -map 0:v:0 "$${codec[@]}" -f mpegts "/video/$$stem.part.ts"
	  mv "$$video/$$stem.part.ts" "$$video/$$stem.ts"
	done

# Localhost-only profile: the certificate names only loopback identities.
tls:
	@if [[ ! -f "$(TLS_DIR)/server.crt" || ! -f "$(TLS_DIR)/server.key" ]]; then
	  mkdir -p "$(TLS_DIR)"
	  openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
	    -keyout "$(TLS_DIR)/server.key" -out "$(TLS_DIR)/server.crt" \
	    -subj "/CN=localhost" \
	    -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"
	  chmod 600 "$(TLS_DIR)/server.key"
	fi

# Per-device configuration: detected device groups.
setup: tls
	@mkdir -p "$$ASSET_ROOT/data/backend"
	install -d -m 2775 "$$ASSET_ROOT/data/dlsps/crops" "$$ASSET_ROOT/data/chatqna/model_cache"
	BACKEND_CAMERAS=$(if $(DEMO_FEEDS),$(CAMERAS),0) python3 -c 'import json,os; print("services:"); [print("  " + service + ":\n    group_add: !override " + json.dumps(list(dict.fromkeys(os.environ[k] for k in keys)))) for service,keys in {"dlsps":("RENDER_GID","ACCEL_GID","ASSET_GID"), "chatqna":("RENDER_GID","ASSET_GID")}.items()]; d=os.environ["TTS_DEVICE"]; print("  tts:\n    environment:\n      TEXT_TO_SPEECH__MODELS__TTS__DEVICE: " + d + "\n  backend:\n    environment:\n      TTS_DEVICE: " + d + "\n      BACKEND_DEMO_CAMERAS: \"" + os.environ["BACKEND_CAMERAS"] + "\"")' > "$$ASSET_ROOT/config/devices.yaml"
	sed -e 's|webrtcAdditionalHosts:.*|webrtcAdditionalHosts: [127.0.0.1, $(COTURN_EXTERNAL_IP)]|' \
	    -e 's|:127.0.0.1:3478|:$(COTURN_EXTERNAL_IP):3478|g' \
	    config/mediamtx/mediamtx.yml > "$$ASSET_ROOT/config/mediamtx.yml"

# ---------------------------------------------------------------- start

define start_demo_cameras
$(COMPOSE) up -d --force-recreate $(CAMERA_IDS)
wait_for "demo camera publishers" paths_ready "$(subst $(space),$(comma),$(CAMERA_IDS))"
endef

define wait_demo_video
wait_for "Backend MQTT feed state" feeds_ready "$(subst $(space),$(comma),$(CAMERA_IDS))"
wait_for "annotated WebRTC publishers" paths_ready "$(subst $(space),$(comma),$(ANNOTATED_IDS))"
endef

# A freshly created GPU container compiles kernels on its first request (~80 s
# measured), so readiness includes one real synthesis rather than /v1/model-info.
speech_warm := curl -fsS --max-time 300 -o /dev/null -H 'Content-Type: application/json' \
  -d '{"input":"Ready.","response_format":"wav"}' http://127.0.0.1:8012/v1/audio/speech

# The Backend image is labelled with a hash of backend/, so an older checkout's
# image is never reused after the sources change. BuildKit asks the registry for
# the base image even when it is cached, so without internet the stale image is
# updated in place from backend/Dockerfile.offline (same Python and packages,
# new application code); a changed requirements.txt still needs internet.
backend_hash = $$(cd backend && find . -type f ! -path '*/__pycache__/*' -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16)
backend_built = $$(docker image inspect -f '{{index .Config.Labels "handheld.source"}}' handheld/backend:dev 2>/dev/null || true)

define build_backend
backend_stale=
export BACKEND_SOURCE_HASH=$(backend_hash)
built=$(backend_built)
if [[ $$built == "$$BACKEND_SOURCE_HASH" ]]; then
  echo 'Backend image matches the current sources'
elif ! $(COMPOSE) build backend; then
  [[ -n $$built ]] || { echo 'Backend image build failed and no Backend image exists yet; the first start needs internet' >&2; false; }
  backend_stale=yes
  $(backend_stale_warning)
fi
endef

define backend_stale_warning
printf '\n%s\n%s\n%s\n%s\n\n' \
  '!!! WARNING: the Backend is NOT the current version !!!' \
  'backend/ changed (for example after git pull) but the rebuild failed (no internet?).' \
  'Starting with the previously built Backend instead; new Backend changes are missing.' \
  'Run the same make command again once online to update it.' >&2
endef

# Started before the Backend and proxy; make check expects all of them running.
APP_SERVICES := coturn mediamtx mqtt metrics dlsps alert-agent chatqna audio-analyzer tts

# Shared by up and demo-up; DEMO_FEEDS adds the looping camera publishers.
define start_application
$(readiness)
$(COMPOSE) config --quiet
trap 'code=$$?; trap - ERR; printf "startup failed; stopping the application\n" >&2; $(COMPOSE) --profile assets stop || true; exit "$$code"' ERR
$(COMPOSE) stop backend dlsps chatqna cam1 cam2
# Stock conversion skips any existing directory, even an interrupted export.
# Preserve partial output before retrying with the unmodified stock backend.
# Stock Chat Q&A calls snapshot_download on every start; without internet each
# model waits ~2 min before falling back to the cache. Once every model is
# cached and exported, start it with the standard HF_HUB_OFFLINE switch.
chat_cache=$$($(COMPOSE) run --rm --no-deps --entrypoint python3 \
  -v "$(CURDIR)/scripts:/handheld/scripts:ro" \
  -v "$(CURDIR)/config/model-download:/handheld/config/model-download:ro" \
  -v "$(CURDIR)/config/dlsps/detector-profile.json:/handheld/config/dlsps/detector-profile.json:ro" \
  -e PYTHONPATH=/handheld/scripts chatqna -c 'import pathlib,yaml; from demo_assets import repair_chat_cache, chat_cache_ready; cache=pathlib.Path("/tmp/model_cache"); models=yaml.safe_load(pathlib.Path("/tmp/model_config/config.yaml").read_text())["model_settings"]; ids=[models[role + "_MODEL_ID"] for role in ("LLM", "EMBEDDING", "RERANKER")]; repair_chat_cache(cache, ids); print("cached" if chat_cache_ready(cache, ids) else "download")' | tail -n 1)
export CHATQNA_HF_HUB_OFFLINE=$$([[ $$chat_cache == cached ]] && echo 1 || echo 0)
printf 'Chat Q&A models: %s\n' "$$([[ $$chat_cache == cached ]] && echo 'cached; no internet needed' || echo 'downloading on this start; internet required')"
$(COMPOSE) up -d $(APP_SERVICES)
WAIT_CONTAINER=handheld-multi-modal-mediamtx-1 wait_for "MediaMTX" curl -fsS --max-time 3 http://127.0.0.1:9997/v3/paths/list
WAIT_CONTAINER=handheld-multi-modal-dlsps-1 wait_for "DLSPS" curl -fsS --max-time 3 http://127.0.0.1:8080/pipelines
WAIT_CONTAINER=handheld-multi-modal-metrics wait_for "Metrics Manager" curl -fsS --max-time 3 http://127.0.0.1:9090/health
$(if $(DEMO_FEEDS),$(start_demo_cameras))
$(build_backend)
$(COMPOSE) up -d --no-deps backend
# nginx resolves upstream IPs at start; recreate so a recreated MediaMTX is reached.
$(COMPOSE) up -d --no-deps --force-recreate proxy
WAIT_CONTAINER=handheld-multi-modal-backend wait_for "Backend through TLS proxy" curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams
$(if $(DEMO_FEEDS),$(wait_demo_video))
wait_for "Backend telemetry" telemetry_ready
WAIT_SECONDS=$(AI_WAIT_SECONDS) WAIT_CONTAINER=handheld-multi-modal-chatqna-core-gpu WAIT_HINT="$(MODEL_NOTE)" wait_for "Chat Q&A neural-chat model" json_ready http://127.0.0.1:8888/model llm_model Intel/neural-chat-7b-v3-3
WAIT_SECONDS=$(AI_WAIT_SECONDS) WAIT_CONTAINER=handheld-multi-modal-audio-analyzer WAIT_HINT="$(MODEL_NOTE)" wait_for "Whisper GPU service" json_ready http://127.0.0.1:8011/health status ok
WAIT_SECONDS=$(AI_WAIT_SECONDS) WAIT_CONTAINER=handheld-multi-modal-tts WAIT_HINT="$(MODEL_NOTE)" wait_for "SpeechT5 $(TTS_DEVICE) service" json_ready http://127.0.0.1:8012/v1/model-info device $(TTS_DEVICE)
WAIT_SECONDS=$(AI_WAIT_SECONDS) wait_for "SpeechT5 first synthesis" $(speech_warm)
WAIT_CONTAINER=handheld-multi-modal-alert-agent wait_for "Alert Agent" curl -fsS --max-time 5 http://127.0.0.1:8010/api/v1/health
dashboard=$$(curl -skfsS --max-time 5 https://127.0.0.1:8443/)
[[ $$dashboard == *'id="pause-updates"'* ]]
trap - ERR
printf '\nApplication ready on this device only: https://localhost:8443/  (trust config/tls/server.crt)\n'
if [[ -n $$backend_stale ]]; then $(backend_stale_warning); fi
$(if $(DEMO_FEEDS),printf 'Demo cameras live: $(CAMERA_IDS)\n',printf 'No cameras yet: add one in the console under Cameras\n')
endef

up: prereq setup
	@$(start_application)

demo-up: DEMO_FEEDS := yes
demo-up: demo-prereq setup
	@$(start_application)

# Optional: upload the committed example packet. Never part of demo-up; the
# operator can instead upload it, or a real document, in the Mission panel.
demo-mission:
	@packet="examples/demo-mission-packet.pdf"
	name="demo-mission-packet.pdf"
	curl -sk --max-time 60 -X DELETE \
	  "https://127.0.0.1:8443/api/mission/documents?document=$$name&confirm=$$name" >/dev/null || true
	curl -skfsS --max-time 60 -X POST https://127.0.0.1:8443/api/mission/documents \
	  -F "files=@$$packet;type=application/pdf" >/dev/null
	printf 'Demo mission packet loaded. Open Mission in the UI to see the brief.\n'

# ---------------------------------------------------------------- operate

status demo-status:
	@$(COMPOSE) --profile assets ps --format 'table {{.Service}}\t{{.Status}}'
	echo
	curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams | python3 -c '
	import json, sys
	streams = [s for s in json.load(sys.stdin)["data"] if s.get("enabled", True)]
	print("\n".join("%-6s %-12s feed %s" % (s["stream_id"], s.get("display_name", ""), "ok" if (s.get("feed") or {}).get("ok") else "not receiving") for s in streams))
	' || echo 'Application is not reachable at https://127.0.0.1:8443/'

# DLSPS stops with the application so stuck pipeline instances are released.
stop demo-stop:
	$(COMPOSE) --profile assets stop

.PHONY: speech-device
# Move SpeechT5 between GPU and CPU without restarting cameras or the LLM.
speech-device: preflight setup
	@$(readiness)
	$(build_backend)
	$(COMPOSE) up -d --no-deps tts backend
	WAIT_SECONDS=$(AI_WAIT_SECONDS) WAIT_CONTAINER=handheld-multi-modal-tts WAIT_HINT="$(MODEL_NOTE)" wait_for "SpeechT5 $(TTS_DEVICE) service" json_ready http://127.0.0.1:8012/v1/model-info device $(TTS_DEVICE)
	WAIT_SECONDS=$(AI_WAIT_SECONDS) wait_for "SpeechT5 first synthesis" $(speech_warm)
	$(COMPOSE) restart proxy
	WAIT_CONTAINER=handheld-multi-modal-backend wait_for "Backend through TLS proxy" curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams
	printf 'Speech now runs on the %s\n' "$(TTS_DEVICE)"

# DLSPS must restart with Backend: a failed publisher can retain crop locks.
pipelines-restart demo-pipelines-restart:
	@$(readiness)
	$(build_backend)
	$(COMPOSE) stop backend dlsps
	$(COMPOSE) up -d --no-deps dlsps
	WAIT_CONTAINER=handheld-multi-modal-dlsps-1 wait_for "DLSPS" curl -fsS --max-time 5 http://127.0.0.1:8080/pipelines
	$(COMPOSE) up -d --no-deps backend
	WAIT_CONTAINER=handheld-multi-modal-backend wait_for "Backend through TLS proxy" curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams
	if [[ -n $$($(COMPOSE) ps -q --status running cam1) ]]; then
	  $(wait_demo_video)
	fi

down demo-down:
	$(COMPOSE) --profile assets down --remove-orphans

# ---------------------------------------------------------------- clean up

# config/mediamtx.yml is a per-device copy generated by older versions.
clean: down
	rm -f "$$ASSET_ROOT/config/devices.yaml" "$$ASSET_ROOT/config/mediamtx.yml"

clean-demo:
	$(COMPOSE) rm -sf cam1 cam2
	$(as_root) 'rm -rf /assets/data/dlsps/demo-video'
	$(ASSET_COMPOSE) down --remove-orphans

clean-history:
	@$(call confirm,camera history$(comma) evidence images$(comma) rules$(comma) alerts and mission documents)
	make --no-print-directory down
	$(as_root) 'rm -rf /assets/data/backend /assets/data/dlsps/crops'
	$(ASSET_COMPOSE) down --remove-orphans
	echo 'History deleted. Start again with make up or make demo-up.'

clean-all:
	@$(call confirm,all history and every downloaded model$(comma) video$(comma) cache and TLS key)
	$(COMPOSE) --profile assets down --volumes --remove-orphans
	$(as_root) 'rm -rf /assets/data /assets/config/tls /assets/config/devices.yaml /assets/config/mediamtx.yml'
	$(ASSET_COMPOSE) down --volumes --remove-orphans
	echo 'Removed. Container images remain; make up or make demo-up downloads everything again.'

# ---------------------------------------------------------------- copy to another device

# Everything a device downloads on its first start, so another device can start
# without internet: images, source, YOLO, demo videos, Chat Q&A models, and the
# Whisper and SpeechT5 caches that live in Docker volumes. History, missions,
# TLS keys and detected device settings stay per device.
BUNDLE_DATA := data/chatqna/model_cache data/dlsps/yolo_export data/dlsps/demo-video
BUNDLE_VOLUMES := audio_analyzer_models audio_analyzer_cache tts_models tts_cache
# Runs as root so container-owned files keep their numeric owners.
define bundle_tar
$(COMPOSE) run --rm --no-deps --user 0:0 --entrypoint /bin/sh \
  -v "$$ASSET_ROOT:/assets" -v "$$BUNDLE:/bundle" \
  $(foreach volume,$(BUNDLE_VOLUMES),-v handheld-multi-modal_$(volume):/volumes/$(volume)) model-downloader -ec
endef

define bundle_dir
[[ -n "$(BUNDLE)" ]] || { echo 'Set BUNDLE=<directory>, for example a folder on a USB disk' >&2; exit 1; }
export BUNDLE=$$(realpath -m "$(BUNDLE)")
endef

bundle: preflight
	@$(bundle_dir)
	for path in $(BUNDLE_DATA); do
	  [[ -d "$$ASSET_ROOT/$$path" ]] || { echo "$$path is missing; run make demo-up once on this device first" >&2; exit 1; }
	done
	images=$$($(COMPOSE) --profile assets config --images | sort -u)
	for image in $$images; do
	  docker image inspect "$$image" >/dev/null 2>&1 || { echo "Image $$image is missing; run make demo-up once on this device first" >&2; exit 1; }
	done
	mkdir -p "$$BUNDLE"
	rm -f "$$BUNDLE/images.tar"
	printf '%s\n' $$images > "$$BUNDLE/images.txt"
	git archive --format=tar --prefix=handheld-multi-modal/ -o "$$BUNDLE/source.tar" HEAD
	[[ -z $$(git status --porcelain --untracked-files=no) ]] || echo 'note: uncommitted changes are not in source.tar' >&2
	if [[ "$(IMAGES)" != no ]]; then
	  echo "Saving $$(wc -l < "$$BUNDLE/images.txt") images (takes several minutes)"
	  docker save -o "$$BUNDLE/images.tar" $$images
	fi
	echo 'Saving models, caches and demo videos'
	$(bundle_tar) 'tar -C /assets -cf /bundle/assets.tar $(BUNDLE_DATA); tar -C /volumes -cf /bundle/volumes.tar $(BUNDLE_VOLUMES); chown $(shell id -u):$(shell id -g) /bundle/assets.tar /bundle/volumes.tar'
	cd "$$BUNDLE"
	sha256sum images.txt source.tar assets.tar volumes.tar $$([[ -f images.tar ]] && echo images.tar) > SHA256SUMS
	printf 'Bundle ready: %s (%s)\n' "$$BUNDLE" "$$(du -sh . | cut -f1)"
	printf 'On the other device: tar -xf source.tar && cd handheld-multi-modal && make bundle-load BUNDLE=%s\n' "$$BUNDLE"

bundle-load: preflight
	@$(bundle_dir)
	echo 'Verifying the bundle checksums (several minutes for large bundles)'
	(cd "$$BUNDLE" && sha256sum -c --quiet SHA256SUMS)
	if [[ -f "$$BUNDLE/images.tar" ]]; then docker load -q -i "$$BUNDLE/images.tar"; fi
	missing=$$(while read -r image; do docker image inspect "$$image" >/dev/null 2>&1 || echo "  $$image"; done < "$$BUNDLE/images.txt")
	[[ -z $$missing ]] || { printf 'These images are missing; load them first:\n%s\n' "$$missing" >&2; exit 1; }
	$(COMPOSE) --profile assets stop
	# Let Compose create the volumes so later starts recognise them as its own.
	$(COMPOSE) create audio-analyzer tts
	echo 'Restoring models, caches and demo videos'
	$(bundle_tar) 'tar -C /assets -xpf /bundle/assets.tar; tar -C /volumes -xpf /bundle/volumes.tar; chown $(shell id -u):$(shell id -g) /assets/data /assets/data/chatqna /assets/data/dlsps'
	echo 'Loaded. Start with make demo-up (or make up); no internet needed.'

# ---------------------------------------------------------------- checks

# OpenVINO models the voice services load from their Docker volumes.
VOICE_MODELS := \
  audio_analyzer_models/openvino/whisper-medium-fp16/openvino_encoder_model.xml \
  audio_analyzer_models/openvino/whisper-medium-fp16/openvino_decoder_model.xml \
  tts_models/openvino/microsoft_speecht5_tts__fp16/openvino_encoder_model.xml \
  tts_models/openvino/microsoft_speecht5_tts__fp16/openvino_decoder_model.xml \
  tts_models/openvino/microsoft_speecht5_tts__fp16/openvino_postnet.xml \
  tts_models/openvino/microsoft_speecht5_tts__fp16/openvino_vocoder.xml

# Read-only: reports whether a start can run offline. Downloads nothing.
check: preflight
	@failed=0 demo_missing=0
	# Items marked -- are needed only by make demo-up and never fail the check.
	report() {
	  if [[ $$1 == ok ]]; then printf 'ok       %s\n' "$$2"
	  elif [[ $$1 == optional ]]; then printf -- '--       %s  -> %s\n' "$$2" "$$3"; demo_missing=1
	  else printf '%-8s %s  -> %s\n' "$${1^^}" "$$2" "$$3"; failed=1; fi
	}
	echo 'Images'
	app_images=$$($(ASSET_COMPOSE) --profile assets config --images | sort -u)
	for image in $$($(COMPOSE) --profile assets config --images | sort -u); do
	  if docker image inspect "$$image" >/dev/null 2>&1; then state=ok fix=
	  elif grep -qxF "$$image" <<< "$$app_images"; then state=missing fix='make up or make demo-up (internet), or make bundle-load'
	  else state=optional fix='make demo-up (internet) downloads it; only the demo cameras use it'; fi
	  report "$$state" "$$image" "$$fix"
	done
	built=$(backend_built)
	[[ -z $$built || $$built == $(backend_hash) ]] && state=ok || state=stale
	report "$$state" 'Backend image matches backend/ sources' 'make up or make demo-up rebuilds it'
	echo 'Models and demo videos'
	code=0; python3 scripts/demo_assets.py check --clips $(DEMO_CLIPS) || code=$$?
	if ((code == 3)); then demo_missing=1; elif ((code)); then failed=1; fi
	# Plain docker run: mount only volumes that already exist, so nothing is created.
	image=$$($(ASSET_COMPOSE) config --images model-downloader)
	mounts=()
	for volume in $(sort $(foreach file,$(VOICE_MODELS),$(firstword $(subst /, ,$(file))))); do
	  if docker volume inspect "handheld-multi-modal_$$volume" >/dev/null 2>&1; then
	    mounts+=(-v "handheld-multi-modal_$$volume:/volumes/$$volume:ro")
	  fi
	done
	# Same integrity check as the host models, inside a container that can read the volumes.
	if (($${#mounts[@]})) && docker image inspect "$$image" >/dev/null 2>&1; then
	  docker run --rm --network none --user 0:0 "$${mounts[@]}" -v "$(CURDIR)/scripts:/scripts:ro" \
	    -v "$(CURDIR)/config:/config:ro" --entrypoint python3 "$$image" /scripts/demo_assets.py check-ir \
	    --root /volumes --fix 'make up or make demo-up (internet), or make bundle-load' $(VOICE_MODELS) || failed=1
	else
	  for file in $(VOICE_MODELS); do report missing "$$file" 'make up or make demo-up (internet), or make bundle-load'; done
	fi
	echo 'Application'
	running=$$($(COMPOSE) ps --status running --services 2>/dev/null || true)
	if [[ -z $$running ]]; then
	  echo 'not started: services were not checked (make up or make demo-up, then make check again)'
	else
	  for service in $(APP_SERVICES) backend proxy; do
	    grep -qxF "$$service" <<< "$$running" && state=ok || state='not running'
	    report "$$state" "$$service container" 'make up or make demo-up'
	  done
	  # Cameras with a running demo publisher must be live; others may wait for a publisher.
	  CHECK_DEMO_CAMERAS=$$(grep -x 'cam[0-9]*' <<< "$$running" | paste -sd, || true) python3 scripts/check_live.py || failed=1
	fi
	echo
	if ((failed)); then echo 'Not ready: run the command shown after each item marked MISSING, STALE, NOT RUNNING or FAILED.' >&2; exit 1; fi
	if [[ -n $$running ]]; then
	  echo 'Ready: every service is running and answered a real request.'
	elif ((demo_missing)); then
	  echo 'Ready for make up (no internet needed). make demo-up also needs the items marked --: run make demo-prereq.'
	else
	  echo 'Ready for make up or make demo-up; no internet needed.'
	fi

test:
	docker run --rm --network none -v "$(CURDIR):/srv" -w /srv/backend handheld/backend:dev python3 test_backend.py

test-assets:
	python3 scripts/test_demo_assets.py

test-ui:
	python3 backend/test_ui.py

test-phase5:
	python3 scripts/smoke/14_phase5_history.py
