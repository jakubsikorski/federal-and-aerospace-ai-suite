# Handheld operator application. Run `make` for the command list and
# docs/bootstrap/application-operations.md for details.
SHELL := /bin/bash
.SHELLFLAGS := -Eeuo pipefail -c
.ONESHELL:
.DEFAULT_GOAL := help

CAMERAS ?= 2
ASSET_ROOT ?= $(CURDIR)
export ASSET_ROOT := $(abspath $(ASSET_ROOT))
export WAIT_SECONDS ?= 360
MODEL_WAIT_SECONDS ?= 3600
AI_WAIT_SECONDS ?= 3600
HOST_NAME ?= $(shell hostname)
HOST_IP ?= $(shell ip -4 -o addr show scope global | awk 'NR==1{split($$4,a,"/"); print a[1]}')
export COTURN_EXTERNAL_IP ?= $(HOST_IP)
export RENDER_GID ?= $(shell stat -c '%g' /dev/dri/renderD128 2>/dev/null)
export ACCEL_GID ?= $(shell stat -c '%g' /dev/accel/accel0 2>/dev/null)
export ASSET_GID := $(shell id -g)
export CAMERAS
TLS_DIR := $(ASSET_ROOT)/config/tls
ASSET_COMPOSE := docker compose -f compose/bootstrap-compose.yaml
# devices.yaml is generated by `setup`; stop/down/status must work without it.
COMPOSE := $(ASSET_COMPOSE) -f compose/cameras.yaml -f compose/phase4-demo.override.yaml \
  $$([[ -f "$(ASSET_ROOT)/config/devices.yaml" ]] && echo -f "$(ASSET_ROOT)/config/devices.yaml")
comma := ,
empty :=
space := $(empty) $(empty)
CAMERA_IDS := $(foreach i,$(shell seq 1 $(CAMERAS) 2>/dev/null),cam$(i))
ANNOTATED_IDS := $(patsubst cam%,annotated%,$(CAMERA_IDS))

.PHONY: help prereq demo-prereq up demo-up demo demo-mission status stop restart demo-restart \
  pipelines-restart down clean clean-demo clean-history clean-all \
  demo-stop demo-down demo-status demo-pipelines-restart \
  preflight setup tls asset-permissions model-downloader-up \
  test test-ui test-assets test-phase5

help:
	@echo 'Handheld operator application'
	@echo
	@echo 'Deploy with your own cameras'
	@echo '  make prereq           Check the host; download the YOLO26s INT8 detector'
	@echo '  make up               Start the application (runs prereq first)'
	@echo '                        Then publish H.264 RTSP on this device to'
	@echo '                        rtsp://127.0.0.1:8554/cam1 ... camN'
	@echo
	@echo 'Deploy with the demo camera feeds'
	@echo '  make demo-prereq      prereq + download and prepare the demo videos'
	@echo '  make demo-up          Start the application with looping demo cameras'
	@echo '  make demo-mission     Optional: load examples/demo-mission-packet.pdf'
	@echo
	@echo 'Operate'
	@echo '  make status           Services and camera feed health'
	@echo '  make stop             Stop every service; nothing is deleted'
	@echo '  make restart          stop + up          (demo: make demo-restart)'
	@echo '  make pipelines-restart  Restart Backend and DLSPS; language models stay loaded'
	@echo '  make down             Remove containers; keep models, history and TLS'
	@echo '  demo-stop, demo-down and demo-status are the same as stop, down and status.'
	@echo
	@echo 'Clean up'
	@echo '  make clean            down + remove generated per-device config'
	@echo '  make clean-demo       Remove demo videos and demo camera containers'
	@echo '  make clean-history CONFIRM=yes  Delete tracks, evidence images, rules, alerts, mission documents'
	@echo '  make clean-all CONFIRM=yes      All of the above + downloaded models, caches and TLS keys'
	@echo
	@echo 'Checks: make test | test-ui | test-assets | test-phase5 (needs demo-up)'
	@echo
	@echo 'Options: CAMERAS=1..3 (default 2)  HOST_IP=<LAN address>  ASSET_ROOT=<path>'
	@echo 'The first start downloads several GB of models and can take up to an hour.'

# Only this small polling helper is shared between startup checks.
define readiness
wait_for() {
  local description=$$1
  shift
  local deadline=$$((SECONDS + WAIT_SECONDS))
  while ((SECONDS < deadline)); do
    if "$$@" >/dev/null 2>&1; then
      printf 'ready: %s\n' "$$description"
      return 0
    fi
    sleep 2
  done
  echo "Timed out waiting for $$description" >&2; return 1
}

paths_ready() {
  local paths=$$1
  curl -fsS --max-time 3 http://127.0.0.1:9997/v3/paths/list |
    python3 -c '
import json, sys
wanted = set(sys.argv[1].split(","))
items = json.load(sys.stdin).get("items", [])
ready = {item.get("name") for item in items if item.get("ready")}
raise SystemExit(0 if wanted <= ready else 1)
' "$$paths"
}

feeds_ready() {
  local streams=$$1
  curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams |
    python3 -c '
import json, sys
wanted = set(sys.argv[1].split(","))
streams = json.load(sys.stdin)["data"]
healthy = {item["stream_id"] for item in streams if item.get("feed", {}).get("ok") is True}
raise SystemExit(0 if wanted <= healthy else 1)
' "$$streams"
}

telemetry_ready() {
  curl -skfsS --max-time 5 https://127.0.0.1:8443/api/metrics |
    python3 -c '
import json, sys
data = json.load(sys.stdin)["data"]
raise SystemExit(0 if data.get("metrics") else 1)
'
}

json_ready() {
  curl -fsS --max-time 5 "$$1" |
    python3 -c 'import json,sys; sys.exit(json.load(sys.stdin).get(sys.argv[1]) != sys.argv[2])' "$$2" "$$3"
}

endef

# Deletes assets that containers may own (crops belong to DLSPS UID 1999).
define as_root
$(ASSET_COMPOSE) run --rm --no-deps --user 0:0 --entrypoint /bin/sh \
  -v "$$ASSET_ROOT:/assets" model-downloader -ec
endef

define confirm
[[ "$(CONFIRM)" == yes ]] || { printf 'This deletes %s.\nRe-run with CONFIRM=yes to continue.\n' "$1" >&2; exit 1; }
endef

# ---------------------------------------------------------------- prerequisites

preflight:
	@fail() { echo "preflight: $$*" >&2; exit 1; }
	command -v docker >/dev/null || fail "docker is required"
	command -v curl >/dev/null || fail "curl is required"
	command -v python3 >/dev/null || fail "python3 is required"
	command -v openssl >/dev/null || fail "openssl is required"
	[[ $$CAMERAS =~ ^[1-3]$$ ]] || fail "CAMERAS must be between 1 and 3"
	[[ -e /dev/dri/renderD128 ]] || fail "/dev/dri/renderD128 (Intel GPU driver) is required"
	[[ -e /dev/accel/accel0 ]] || fail "/dev/accel/accel0 (Intel NPU driver) is required"

# Containers can leave host bind mounts root-owned after an interrupted run.
# Repair only assets Make owns; never touch DLSPS crop stores, which belong to
# UID 1999 and can be mode 2700 while a producer is active.
asset-permissions:
	@$(ASSET_COMPOSE) run --rm --no-deps --user 0:0 --entrypoint /bin/sh \
	  -e HOST_UID="$$(id -u)" -e HOST_GID="$$(id -g)" \
	  -v "$$ASSET_ROOT:/bootstrap-assets" model-downloader -ec \
	  'mkdir -p /bootstrap-assets/data/backend \
	            /bootstrap-assets/data/model-download \
	            /bootstrap-assets/data/dlsps/yolo_export \
	            /bootstrap-assets/data/dlsps/demo-video \
	            /bootstrap-assets/config/tls; \
	   chown -R "$$HOST_UID:$$HOST_GID" \
	     /bootstrap-assets/data/backend \
	     /bootstrap-assets/data/model-download \
	     /bootstrap-assets/data/dlsps/yolo_export \
	     /bootstrap-assets/data/dlsps/demo-video \
	     /bootstrap-assets/config/tls'

# Stock Model Download (--plugins ultralytics) on loopback port 8200.
model-downloader-up:
	@make --no-print-directory asset-permissions
	@$(readiness)
	install -d -m 2775 "$$ASSET_ROOT/data/model-download"
	$(ASSET_COMPOSE) up -d --no-deps model-downloader
	WAIT_SECONDS=$(MODEL_WAIT_SECONDS) wait_for "Model Download (ultralytics, port 8200)" curl -fsS --max-time 5 http://127.0.0.1:8200/api/v1/health

# These prerequisites are deliberately sequential, including under make -j.
.NOTPARALLEL:

# Chat Q&A, Whisper and SpeechT5 download their own models on first start.
prereq: preflight asset-permissions
	@if python3 scripts/demo_assets.py check-model; then
	  echo 'YOLO26s INT8 cache verified'
	else
	  code=$$?
	  [[ $$code == 2 ]] || exit "$$code"
	  make --no-print-directory model-downloader-up
	  python3 scripts/demo_assets.py model --timeout $(MODEL_WAIT_SECONDS)
	fi

demo-prereq: prereq
	@python3 scripts/demo_assets.py video
	video="$$ASSET_ROOT/data/dlsps/demo-video"
	# Every pinned source becomes MPEG-TS for the camera publishers. classroom.avi
	# is only remuxed. The mp4 clips have 4-10 s keyframe gaps, so each
	# -stream_loop wrap left the hardware decoder without references and smeared
	# macroblocks into crops until the next keyframe. They are re-encoded once
	# here: keyframe every second, no B-frames, same resolution, at most 30 fps.
	# Detection runs on every frame (zero-term tracking); a 60 fps source outran
	# the detector and its pipeline ended every ~90 s. The .max30 name keeps an
	# older full-rate cache from being reused.
	for source in classroom.avi person-bicycle-car-detection.mp4 pexels-34622113.mp4; do
	  stem="$${source%.*}"
	  if [[ $$source == *.avi ]]; then
	    codec=(-c copy)
	  else
	    stem="$$stem.max30"
	    codec=(-c:v libx264 -preset medium -crf 18 -pix_fmt yuv420p -bf 0 -sc_threshold 0 \
	           -fpsmax 30 -force_key_frames 'expr:gte(t,n_forced*1)')
	  fi
	  [[ -f "$$video/$$stem.ts" ]] && continue
	  docker run --rm --user "$$(id -u):$$(id -g)" -v "$$video:/video" jrottenberg/ffmpeg:6.1-ubuntu2404 \
	    -hide_banner -loglevel warning -y -fflags +genpts -i "/video/$$source" \
	    -map 0:v:0 "$${codec[@]}" -f mpegts "/video/$$stem.part.ts"
	  mv "$$video/$$stem.part.ts" "$$video/$$stem.ts"
	done

tls:
	@test -n "$(COTURN_EXTERNAL_IP)" || { echo 'Set HOST_IP to the device LAN address' >&2; exit 1; }
	if [[ ! -f "$(TLS_DIR)/server.crt" || ! -f "$(TLS_DIR)/server.key" ]]; then
	  mkdir -p "$(TLS_DIR)"
	  openssl req -x509 -newkey rsa:2048 -nodes -days 825 \
	    -keyout "$(TLS_DIR)/server.key" -out "$(TLS_DIR)/server.crt" \
	    -subj "/CN=$(HOST_NAME)" \
	    -addext "subjectAltName=DNS:$(HOST_NAME),DNS:localhost,IP:$(COTURN_EXTERNAL_IP),IP:127.0.0.1"
	  chmod 600 "$(TLS_DIR)/server.key"
	fi

# Per-device configuration: detected device groups and the LAN address.
setup: tls
	@mkdir -p "$$ASSET_ROOT/data/backend"
	install -d -m 2775 "$$ASSET_ROOT/data/dlsps/crops" "$$ASSET_ROOT/data/chatqna/model_cache"
	python3 -c 'import json,os; print("services:"); [print("  " + service + ":\n    group_add: !override " + json.dumps(list(dict.fromkeys(os.environ[k] for k in keys)))) for service,keys in {"dlsps":("RENDER_GID","ACCEL_GID","ASSET_GID"), "chatqna":("RENDER_GID","ASSET_GID")}.items()]' > "$$ASSET_ROOT/config/devices.yaml"
	sed -e 's|webrtcAdditionalHosts:.*|webrtcAdditionalHosts: [127.0.0.1, $(COTURN_EXTERNAL_IP)]|' \
	    -e 's|:127.0.0.1:3478|:$(COTURN_EXTERNAL_IP):3478|g' \
	    config/mediamtx/mediamtx.yml > "$$ASSET_ROOT/config/mediamtx.yml"

# ---------------------------------------------------------------- start

define start_demo_cameras
$(COMPOSE) up -d --force-recreate $(CAMERA_IDS)
wait_for "demo camera publishers" paths_ready "$(subst $(space),$(comma),$(CAMERA_IDS))"
endef

define wait_demo_video
wait_for "Backend MQTT feed state" feeds_ready "$(subst $(space),$(comma),$(CAMERA_IDS))"
wait_for "annotated WebRTC publishers" paths_ready "$(subst $(space),$(comma),$(ANNOTATED_IDS))"
endef

# Shared by up and demo-up; DEMO_FEEDS adds the looping camera publishers.
define start_application
$(readiness)
$(COMPOSE) config --quiet
trap 'code=$$?; trap - ERR; printf "startup failed; stopping the application\n" >&2; $(COMPOSE) --profile assets stop || true; exit "$$code"' ERR
$(COMPOSE) stop backend dlsps chatqna cam1 cam2 cam3 cam4
# Stock conversion skips any existing directory, even an interrupted export.
# Preserve partial output before retrying with the unmodified stock backend.
$(COMPOSE) run --rm --no-deps --entrypoint python3 \
  -v "$(CURDIR)/scripts:/bootstrap/scripts:ro" \
  -v "$(CURDIR)/config/model-download:/bootstrap/config/model-download:ro" \
  -v "$(CURDIR)/config/dlsps/detector-profile.json:/bootstrap/config/dlsps/detector-profile.json:ro" \
  -e PYTHONPATH=/bootstrap/scripts chatqna -c 'import pathlib,yaml; from demo_assets import repair_chat_cache; models=yaml.safe_load(pathlib.Path("/tmp/model_config/config.yaml").read_text())["model_settings"]; repair_chat_cache(pathlib.Path("/tmp/model_cache"), [models[role + "_MODEL_ID"] for role in ("LLM", "EMBEDDING", "RERANKER")])'
$(COMPOSE) up -d coturn mediamtx mqtt metrics dlsps alert-agent chatqna audio-analyzer tts
wait_for "MediaMTX" curl -fsS --max-time 3 http://127.0.0.1:9997/v3/paths/list
wait_for "DLSPS" curl -fsS --max-time 3 http://127.0.0.1:8080/pipelines
wait_for "Metrics Manager" curl -fsS --max-time 3 http://127.0.0.1:9090/health
$(if $(DEMO_FEEDS),$(start_demo_cameras))
$(COMPOSE) up -d --build --no-deps backend
$(COMPOSE) up -d --no-deps proxy
wait_for "Backend through TLS proxy" curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams
$(if $(DEMO_FEEDS),$(wait_demo_video))
wait_for "Backend telemetry" telemetry_ready
WAIT_SECONDS=$(AI_WAIT_SECONDS) wait_for "Chat Q&A neural-chat model" json_ready http://127.0.0.1:8888/model llm_model Intel/neural-chat-7b-v3-3
WAIT_SECONDS=$(AI_WAIT_SECONDS) wait_for "Whisper GPU service" json_ready http://127.0.0.1:8011/health status ok
WAIT_SECONDS=$(AI_WAIT_SECONDS) wait_for "SpeechT5 GPU service" json_ready http://127.0.0.1:8012/v1/model-info device GPU
wait_for "Alert Agent" curl -fsS --max-time 5 http://127.0.0.1:8010/api/v1/health
dashboard=$$(curl -skfsS --max-time 5 https://127.0.0.1:8443/)
[[ $$dashboard == *'id="pause-updates"'* ]]
trap - ERR
printf '\nApplication ready: https://%s:8443/  (trust config/tls/server.crt on the tablet)\n' "$(COTURN_EXTERNAL_IP)"
$(if $(DEMO_FEEDS),printf 'Demo cameras live: $(CAMERA_IDS)\n',printf 'Waiting for cameras: publish H.264 RTSP to rtsp://127.0.0.1:8554/$(firstword $(CAMERA_IDS)) ... $(lastword $(CAMERA_IDS)); check with make status\n')
endef

up: prereq setup
	@$(start_application)

demo-up: DEMO_FEEDS := yes
demo-up: demo-prereq setup
	@$(start_application)

demo: demo-up

# Optional: upload the committed example packet. Never part of demo-up; the
# operator can instead upload it, or a real document, in the Mission panel.
demo-mission:
	@packet="examples/demo-mission-packet.pdf"
	name="demo-mission-packet.pdf"
	curl -sk --max-time 60 -X DELETE \
	  "https://127.0.0.1:8443/api/mission/documents?document=$$name&confirm=$$name" >/dev/null || true
	curl -skfsS --max-time 60 -X POST https://127.0.0.1:8443/api/mission/documents \
	  -F "files=@$$packet;type=application/pdf" >/dev/null
	printf 'Demo mission packet loaded. Open Mission in the UI to see the brief.\n'

# ---------------------------------------------------------------- operate

status demo-status:
	@$(COMPOSE) --profile assets ps --format 'table {{.Service}}\t{{.Status}}'
	echo
	curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams | python3 -c '
	import json, sys
	streams = [s for s in json.load(sys.stdin)["data"] if s.get("enabled", True)]
	print("\n".join("%-6s %-12s feed %s" % (s["stream_id"], s.get("display_name", ""), "ok" if (s.get("feed") or {}).get("ok") else "not receiving") for s in streams))
	' || echo 'Application is not reachable at https://127.0.0.1:8443/'

# DLSPS stops with the application so stuck pipeline instances are released.
stop demo-stop:
	$(COMPOSE) --profile assets stop

restart: stop up

demo-restart: stop demo-up

# DLSPS must restart with Backend: a failed publisher can retain crop locks.
pipelines-restart demo-pipelines-restart:
	@$(readiness)
	$(COMPOSE) stop backend dlsps
	$(COMPOSE) up -d --no-deps dlsps
	wait_for "DLSPS" curl -fsS --max-time 5 http://127.0.0.1:8080/pipelines
	$(COMPOSE) up -d --no-deps backend
	wait_for "Backend through TLS proxy" curl -skfsS --max-time 5 https://127.0.0.1:8443/api/streams
	if [[ -n $$($(COMPOSE) ps -q --status running cam1) ]]; then
	  $(wait_demo_video)
	fi

down demo-down:
	$(COMPOSE) --profile assets down --remove-orphans

# ---------------------------------------------------------------- clean up

clean: down
	rm -f "$$ASSET_ROOT/config/devices.yaml" "$$ASSET_ROOT/config/mediamtx.yml"

clean-demo:
	$(COMPOSE) rm -sf cam1 cam2 cam3 cam4
	$(as_root) 'rm -rf /assets/data/dlsps/demo-video'
	$(ASSET_COMPOSE) down --remove-orphans

clean-history:
	@$(call confirm,camera history$(comma) evidence images$(comma) rules$(comma) alerts and mission documents)
	make --no-print-directory down
	$(as_root) 'rm -rf /assets/data/backend /assets/data/dlsps/crops'
	$(ASSET_COMPOSE) down --remove-orphans
	echo 'History deleted. Start again with make up or make demo-up.'

clean-all:
	@$(call confirm,all history and every downloaded model$(comma) video$(comma) cache and TLS key)
	$(COMPOSE) --profile assets down --volumes --remove-orphans
	$(as_root) 'rm -rf /assets/data /assets/config/tls /assets/config/devices.yaml /assets/config/mediamtx.yml'
	$(ASSET_COMPOSE) down --volumes --remove-orphans
	echo 'Removed. Container images remain; make up or make demo-up downloads everything again.'

# ---------------------------------------------------------------- checks

test:
	docker run --rm --network none -v "$(CURDIR):/srv" -w /srv/backend handheld/backend:dev python3 test_backend.py

test-assets:
	python3 scripts/test_demo_assets.py

test-ui:
	python3 backend/test_ui.py

test-phase5:
	python3 scripts/smoke/14_phase5_history.py
